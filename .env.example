# Optional. Everything here can be set from the Settings page instead, and that is the easier way.
# Copy to .env only for what you want to manage outside the page. A value set here locks that field in Settings.
# Never commit .env.

# Sign-in. "password" is the default. Use "none" only behind a gate of your own, and name its hostname in PAPER_HOSTS.
# PAPER_AUTH=password
# PAPER_HOSTS=paper.example.com
# Sets the password here instead of using the setup code. It is never written to disk.
# PAPER_PASSWORD=

# PAPER_NAME=The Times
# blackletter, fraktur, fatface, serif or theme
# PAPER_FONT=blackletter
# PAPER_TZ=America/New_York

# WARROOM_URL=https://war.wakxi.com/api/v1

# COMMONS_URL=
# COMMONS_TOKEN=
# ANTHROPIC_ADMIN_KEY=
# OPENROUTER_KEY=
# TWILIO_ACCOUNT=
# TWILIO_KEY=
# TWILIO_SECRET=
# DEEPGRAM_KEY=
# LIVEKIT_PROJECT=
# LIVEKIT_TOKEN=

# LEARN_LAYOUT=true
# CHART_STYLE=dots

# WEATHER_PLACE=Oakland
# WEATHER_UNITS=fahrenheit
# SPORTS_LEAGUES=nfl,nba,mlb,nhl,epl,ucl

# PLEX_URL=
# PLEX_TOKEN=
# SONARR_URL=
# SONARR_KEY=
# RADARR_URL=
# RADARR_KEY=
# SEERR_URL=
# SEERR_KEY=

# PVE_URL=
# PVE_TOKEN=
# PVE_NODE=pve

# MAIL_TENANT=
# MAIL_CLIENT_ID=
# MAIL_CLIENT_SECRET=

# AI provider: anthropic, openai, gemini, xai, openrouter, groq, mistral, deepseek, together, ollama, lmstudio or custom
# AI_PROVIDER=anthropic
# AI_KEY=
# AI_MODEL=
# AI_URL=
# The token AI clients send to /mcp and /api/ai. Long and random. Sets it here instead of making one in Settings.
# PAPER_AI_TOKEN=

# MONEY_URL=
# FEED_TOKEN=
